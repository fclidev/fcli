{
  "name": "@fcli.dev/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for f — static HTML, built with Astro",
  "scripts": {
    "build": "astro build",
    "check": "astro build && node check.js",
    "dev": "astro dev",
    "preview": "astro preview"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0",
    "astro-better-link-checker": "^1.0.1",
    "prettier": "^3.9.9"
  },
  "prettier": {
    "overrides": [
      {
        "files": [
          "content/**/*.md"
        ],
        "options": {
          "proseWrap": "preserve"
        }
      }
    ]
  }
}
