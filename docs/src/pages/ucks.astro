---
/**
 * /ucks/ — ucks published on npm.
 *
 * WHY A ROUTE RATHER THAN A CONTENT FILE
 *
 * The page's centre is UckRegistry, a component with a script. Astro's .md renderer
 * cannot import components — only .mdx can — and adding MDX for one page would mean a
 * second markdown pipeline plus a format that the other eleven pages do not use. The
 * prose here is short and tightly coupled to the widget ("the list below is fetched
 * when you load this page"), so keeping them in one file is worth more than uniformity
 * about where prose lives.
 *
 * CONSEQUENCE, STATED SO IT DOES NOT SURPRISE ANYONE
 *
 * This page is not in src/content/pages, so it has no content-collection schema:
 * its title and summary are plain constants below, and nothing enforces the
 * summary-length rule the schema applies to the others. check.js still asserts the
 * built page has a non-empty description, so the failure it would catch is caught
 * after the fact rather than at the source. src/nav.ts lists it as a ROUTE_PAGE so the
 * collection-vs-nav assertion does not demand a .md file that must not exist.
 */
import Page from "../layouts/Page.astro";
import UckRegistry from "../components/UckRegistry.astro";
import { allTitles, urlFor } from "../nav";

const TITLE = "Ucks";
const SUMMARY =
  "Uck packages published on npm: every package tagged fcli-uck, fetched live, plus how to install one and where the contract is documented.";

// No toc: the page is a heading, a two-sentence framing paragraph, a link and the
// widget. A level-2 heading list over a page with no level-2 headings would be worse
// than none, and Page renders level 2 only.
const TOC: { id: string; text: string; level: number }[] = [];

// The sidebar needs labels for every page, including the collection-backed ones, which
// a route cannot read from astro:content at module scope. allSlugs gives the order; the
// labels come from a single map so this page cannot drift silently — the worst case is
// a sidebar label that reads as the slug.
// Sidebar labels come from LABELS in src/nav.ts, keyed by the same slugs the sidebar
// lists. A local copy here previously went stale when pages moved under /docs/ and
// rendered "docs/config" in the sidebar on every page that used it.
const titles = allTitles([]);
---

<Page
  title={TITLE}
  description={SUMMARY}
  slug="ucks"
  url={urlFor("ucks")}
  titles={titles}
  headings={TOC}
>
  <h1 id="ucks">Ucks</h1>

  <p>
    Uck packages published on npm. Anything carrying the <code>fcli-uck</code> keyword
    appears here and anything that stops carrying it disappears, so this reflects npm
    rather than a list anyone has to maintain. A package may bundle several ucks.
  </p>

  <p>
    How they work, how to install one, and how to write one:
    <a href="/docs/ucks/">Ucks</a>.
  </p>

  <p class="note">
    Fetched from npm when this page loads, so it is current without a site rebuild. It
    needs JavaScript.
  </p>

  <UckRegistry />
</Page>
